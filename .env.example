# Kakao Developers app credentials
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Fill once after first OAuth authorization
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=

# Data collection window
LOOKBACK_DAYS=2
MAX_ITEMS_PER_SOURCE=30
KCI_LOOKBACK_DAYS=30
MAX_KCI_ITEMS=60
MAX_SEND_COUNT=5

# Optional: stricter journal quality filter (SCI-like)
# true: only send papers from JOURNAL_WHITELIST (plus arXiv)
# false: send all matched papers
STRICT_JOURNAL_FILTER=false

# Optional: custom keywords (comma separated)
# KEYWORDS=webtoon,animation,digital comics,text mining,NLP
